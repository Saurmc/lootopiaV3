{
  "name": "lootopia-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "echo Run workspace-specific dev scripts: npm run dev -w <workspace>",
    "lint": "npm run lint --workspaces --if-present"
  }
}
