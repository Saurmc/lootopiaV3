# API
PORT=3000
NODE_ENV=development

# Database (PostgreSQL + PostGIS via Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USER=lootopia
DB_PASSWORD=changeme
DB_NAME=lootopia

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# MapLibre (pas de clé API requise, open-source)
MAPLIBRE_STYLE_URL=https://demotiles.maplibre.org/style.json

# MinIO (stockage fichiers compatible S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=lootopia

# pgAdmin (interface administration BDD)
PGADMIN_EMAIL=admin@lootopia.local
PGADMIN_PASSWORD=admin

# Backoffice URL — utilisé dans les liens d'invitation envoyés aux partenaires
BACKOFFICE_URL=http://localhost:5173

# SMTP (optionnel en dev — si absent, les emails sont loggués dans la console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@lootopia.fr
