{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "dependencies": {
    "@lootopia/shared": "*",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@react-native-async-storage/async-storage": "^3.0.1",
    "@react-navigation/bottom-tabs": "^7.15.6",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/native-stack": "^7.14.6",
    "@reactvision/react-viro": "^2.55.0",
    "@tanstack/react-query": "^5.91.2",
    "axios": "^1.13.6",
    "expo": "~55.0.8",
    "expo-camera": "^55.0.10",
    "expo-dev-client": "^56.0.18",
    "expo-file-system": "^55.0.11",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.14",
    "expo-localization": "^56.0.6",
    "expo-location": "^55.1.4",
    "expo-secure-store": "~13.0.0",
    "expo-status-bar": "~55.0.4",
    "i18next": "^26.3.1",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.83.2",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "15.15.3",
    "react-native-vector-icons": "^10.3.0",
    "react-test-renderer": "^19.2.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "@types/react-native": "^0.72.8",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "react-native",
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "babelConfig": true,
          "tsconfig": {
            "jsx": "react-native",
            "allowSyntheticDefaultImports": true
          }
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-navigation|@maplibre|expo|expo-location|@tanstack|nativewind|@lootopia)/)"
    ],
    "moduleNameMapper": {
      "@lootopia/shared": "<rootDir>/../../packages/shared/src/index.ts"
    },
    "testEnvironment": "node"
  },
  "private": true
}
